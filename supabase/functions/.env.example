# Loaded automatically by `supabase start` for all edge functions.
# Copy to supabase/functions/.env and fill in values. Do not commit.
#
# Confirm local URLs with: npm run supabase:status
# Do not put SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY here. The local stack
# injects those automatically (names starting with SUPABASE_ are skipped).
#
# After editing this file, restart the stack:
#   supabase stop && supabase start

# Shared secret for sync-open-data-feed (any non-empty string is fine locally).
PEELS_OPEN_DATA_SYNC_SECRET=local-dev-open-data-sync

# Listing owner for US mirrored stubs. Local seed uses demo-host; production uses Stubs USA.
PEELS_OPEN_DATA_OWNER_ID_USA=2c9ae20c-2469-4e60-84b3-39268697717c

# Optional: higher Socrata rate limits for full NYC sync tests.
PEELS_NYC_OPEN_DATA_APP_TOKEN=

# Other edge functions you serve locally may need these:
GENERAL_EMAIL_ADDRESS=
PEELS_PUBLIC_SITE_URL=https://www.peels.org
RESEND_API_KEY=
SEND_EMAIL_HOOK_SECRET=
PEELS_CHAT_MESSAGE_WEBHOOK_SECRET=
